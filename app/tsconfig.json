{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    // WebGPU staat niet in lib.dom; de speler heeft GPUBufferUsage en vrienden nodig.
    "types": ["vite/client", "@webgpu/types"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    // `@editie` is in Vite een alias naar app/edities/<BEATCUT_EDITIE>/ (zie
    // vite.config.ts). tsc kent die niet en typt tegen de standaardeditie;
    // `src/editie.ts` legt daar het type `Editie` overheen, zodat een veld dat
    // bij BeatCut null is (motto, logo) in een andere editie gewoon mag.
    "paths": { "@editie/*": ["./edities/beatcut/*"] },
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
