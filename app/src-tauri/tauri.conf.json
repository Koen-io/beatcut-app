{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BeatCut",
  "version": "0.3.2",
  "identifier": "io.koen.beatcut",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BeatCut",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "theme": "Dark",
        "backgroundColor": "#0B0C0F"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://asset.localhost; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$VIDEO/BeatCut/**",
          "$HOME/BeatCut/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "Video's die op de beat liggen",
    "resources": {
      "../../installer/uit/beatcut-engine/": "engine/",
      "../../installer/uit/ffmpeg/huidig/": "engine/bin/",
    "../../installer/uit/compositor/": "engine/bin/"
    },
    "macOS": {
      "dmg": {
        "background": "../../ontwerp/beatcut2/icoon/dmg-achtergrond.tiff",
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 180
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 180
        }
      }
    },
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "../../ontwerp/beatcut2/icoon/nsis-header.bmp",
        "sidebarImage": "../../ontwerp/beatcut2/icoon/nsis-zijbalk.bmp",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "Dutch",
          "English"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDN0MzMkZGNUUzMUIxREYKUldUZnNURmUveko4TEMrQTI5WWNFSFpObFg4NUdpTEZ2ZnZEWHpkb0RwR2J0dGFCVVQyZXY2RGgK",
      "endpoints": [
        "https://github.com/Koen-io/beatcut-releases/releases/latest/download/latest.json"
      ]
    }
  }
}
